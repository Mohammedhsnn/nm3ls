<div class="page-width narrow">
  <h1>Log in</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="LoginEmail">Email</label><input id="LoginEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    {%- if form.password_needed -%}
      <div class="field" style="margin-top:12px"><label for="LoginPassword">Password</label><input id="LoginPassword" type="password" name="customer[password]" autocomplete="current-password" required></div>
      <p style="margin-top:8px"><a class="link" href="#recover" data-recover-toggle>Forgot your password?</a></p>
    {%- endif -%}
    <button class="btn btn--full" type="submit" style="margin-top:16px">Log in</button>
  {%- endform -%}
  <a class="link" href="{{ routes.account_register_url }}">Create an account</a>

  <div id="recover" style="margin-top:24px">
    <h2 class="eyebrow">Reset your password</h2>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}<p class="form-message form-message--success">Check your email for a reset link.</p>{%- endif -%}
      {{ form.errors | default_errors }}
      <div class="field" style="margin-top:10px"><label for="RecoverEmail">Email</label><input id="RecoverEmail" type="email" name="email" autocomplete="email" required></div>
      <button class="btn btn--outline btn--full" type="submit" style="margin-top:12px">Send reset link</button>
    {%- endform -%}
  </div>
  {%- if shop.checkout.guest_login -%}
    {%- form 'guest_login' -%}<button class="btn btn--outline btn--full" type="submit">Continue as guest</button>{%- endform -%}
  {%- endif -%}
</div>

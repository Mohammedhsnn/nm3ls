<div class="page-width narrow">
  <h1>Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">New password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field" style="margin-top:12px"><label for="ResetConfirm">Confirm password</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--full" type="submit" style="margin-top:16px">Reset password</button>
  {%- endform -%}
</div>

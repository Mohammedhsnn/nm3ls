<div class="page-width narrow">
  <h1>Activate account</h1>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ActPassword">Password</label><input id="ActPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field" style="margin-top:12px"><label for="ActConfirm">Confirm password</label><input id="ActConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--full" type="submit" style="margin-top:16px">Activate</button>
    <button class="btn btn--outline btn--full" type="submit" name="decline" style="margin-top:8px">Decline invitation</button>
  {%- endform -%}
</div>

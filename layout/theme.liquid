<!doctype html>
{%- liquid
  assign html_class = 'no-js'
  if settings.enable_animations
    assign html_class = html_class | append: ' motion'
  endif
  if settings.show_grain
    assign html_class = html_class | append: ' grain'
  endif
  if request.design_mode
    assign html_class = html_class | append: ' design-mode'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" class="{{ html_class }}"{% if settings.custom_cursor %} data-cursor{% endif %}>
  <head>
    <meta charset="utf-8">
    <script>
      // Enable JS-only styles, and if motion.js never runs, reveal everything
      // after 3s so scroll-hidden content can't stay hidden.
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      setTimeout(function () { if (!window.__nmlMotion) document.documentElement.classList.add('motion-fallback'); }, 3000);
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {% # theme-check-disable RemoteAsset %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800&family=Bowlby+One&family=DM+Mono:wght@400;500&family=Shrikhand&display=swap">
    {% # theme-check-enable RemoteAsset %}

    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'motion.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {%- if settings.enable_animations -%}
      <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    {% render 'intro' %}
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {%- if settings.enable_animations -%}<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>{%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    <div class="toast" id="Toast" role="status" aria-live="polite"></div>

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cart: {{ routes.cart_url | json }}
        },
        cartType: {{ settings.cart_type | json }}
      };
    </script>
  </body>
</html>

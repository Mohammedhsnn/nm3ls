{%- liquid
  assign s = section.settings
-%}
<section class="hero" data-hero {{ section.shopify_attributes }}>
  <div class="page-width hero__inner">
    <div>
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow hero-in" style="--d: 0"><span class="dot"></span>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <div class="wordmark" aria-hidden="true">
        <span class="wordmark__big">
          {%- assign chars = s.wordmark | split: '' -%}
          {%- for c in chars -%}<span class="char" style="--c: {{ forloop.index0 }}">{{ c | escape }}</span>{%- endfor -%}
        </span>
        {%- if s.script != blank -%}<span class="wordmark__script hero-stamp">{{ s.script | escape }}</span>{%- endif -%}
      </div>
      <h1 class="hero-in" style="--d: 4">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<div class="hero__text rte hero-in" style="--d: 5">{{ s.text }}</div>{%- endif -%}
      <div class="hero__ctas hero-in" style="--d: 6">
        {%- if s.button_label != blank -%}<a class="btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>{%- endif -%}
        {%- if s.button2_label != blank -%}<a class="btn btn--outline" href="{{ s.button2_link | default: routes.collections_url }}">{{ s.button2_label | escape }}</a>{%- endif -%}
      </div>
    </div>

    <div class="hero__media hero-media-in">
      {%- if s.show_vinyl -%}
        <div class="vinyl" data-vinyl aria-hidden="true"><div class="vinyl__label"><span>{{ s.vinyl_label | escape }}</span></div></div>
      {%- endif -%}
      <figure class="hero__frame">
        <div class="hero__img" data-parallax="0.08">
        {%- if s.image != blank -%}
          {%- assign hero_alt = s.image.alt | default: s.heading -%}
          {{ s.image | image_url: width: 1200 | image_tag:
            loading: 'eager', fetchpriority: 'high',
            widths: '480, 720, 960, 1200',
            sizes: '(min-width: 860px) 460px, 76vw',
            alt: hero_alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
        </div>
        <figcaption class="hero__caption"><span>{{ s.caption_left | escape }}</span><span>{{ s.caption_right | escape }}</span></figcaption>
      </figure>
      {%- if s.sticker_big != blank -%}
        <div class="hero__sticker" data-spin-on-scroll aria-hidden="true"><div><b>{{ s.sticker_big | escape }}</b><small>{{ s.sticker_small | escape | newline_to_br }}</small></div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Back to school drop — live now" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "NML" },
    { "type": "text", "id": "script", "label": "Script word", "default": "club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reworked denim, club tees & one-of-one thrift finds." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every 1/1 piece is picked, cut and finished by hand. There is one of each — when it sells, it's gone for good.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Dig the 1/1 crate" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption_left", "label": "Caption left", "default": "Blur Club Tee" },
    { "type": "text", "id": "caption_right", "label": "Caption right", "default": "Side A" },
    { "type": "checkbox", "id": "show_vinyl", "label": "Show spinning record", "default": true },
    { "type": "text", "id": "vinyl_label", "label": "Record label text", "default": "nml" },
    { "type": "text", "id": "sticker_big", "label": "Sticker big text", "default": "1/1" },
    { "type": "textarea", "id": "sticker_small", "label": "Sticker small text", "default": "weekly\ndrops" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

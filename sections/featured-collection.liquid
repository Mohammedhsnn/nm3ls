{%- liquid
  assign s = section.settings
  assign col = s.collection
-%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <h2 data-reveal="clip">{{ s.heading | escape }}{% if s.script != blank %}<em>{{ s.script | escape }}</em>{% endif %}</h2>
      <div data-reveal="up" style="--i: 2">
        {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
        {%- if col != blank and s.show_view_all -%}<p style="margin-top:12px"><a class="link" href="{{ col.url }}">View all {{ col.products_count }}</a></p>{%- endif -%}
      </div>
    </div>
    <div class="grid" style="--cols: {{ s.columns }}" data-reveal-group>
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: s.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.columns) -%}
          <div class="card">
            <div class="card__media">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="card__info"><h3 class="card__title">Product name</h3><span class="price-tag">{{ 4500 | money }}</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
    { "type": "text", "id": "script", "label": "Script accent", "default": "fresh press" },
    { "type": "text", "id": "text", "label": "Text", "default": "The newest drop. Tees run S–2XL." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

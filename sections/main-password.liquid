<section class="narrow" style="text-align:center">
  <span class="logo" style="justify-content:center"><span class="logo__mark">NML</span><span class="logo__script">club</span></span>
  <h1>{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p style="color:var(--muted)">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    <div class="field" style="text-align:left">
      <label for="Password">Store password</label>
      <input type="password" id="Password" name="password" autocomplete="current-password" required>
    </div>
    {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.messages.form }}</p>{%- endif -%}
    <button class="btn btn--full" type="submit" style="margin-top:12px">Enter</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Next drop loading" }
  ]
}
{% endschema %}

{%- comment -%}
  Rendered once in the layout and re-fetched through the Section Rendering API
  (/?sections=cart-drawer) whenever the cart changes.
{%- endcomment -%}
<div class="drawer-scrim" data-drawer-scrim></div>
<aside class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" data-cart-drawer>
  <div class="cart-drawer__head">
    <h2 id="CartDrawerTitle">Your bag <span class="cart-count" data-cart-count>{{ cart.item_count }}</span></h2>
    <button type="button" class="cart-drawer__close" data-drawer-close>Close</button>
  </div>
  <div class="cart-drawer__body" data-cart-body>
    {%- if cart.item_count > 0 -%}
      {% render 'cart-items' %}
    {%- else -%}
      <div class="cart-empty">
        <p>Your bag is empty.</p>
        <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">Start digging</a>
      </div>
    {%- endif -%}
  </div>
  {%- if cart.item_count > 0 -%}
    <form class="cart-drawer__foot" action="{{ routes.cart_url }}" method="post" data-cart-foot>
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="cart-row"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
      {%- endfor -%}
      <div class="cart-row cart-row--total"><span>Subtotal</span><span>{{ cart.total_price | money_with_currency }}</span></div>
      <p class="cart-note">{{ settings.cart_note_text | escape }}</p>
      <button type="submit" name="checkout" class="btn btn--full">Checkout</button>
    </form>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}

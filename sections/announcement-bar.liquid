{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
-%}
{%- if messages.size > 0 -%}
  <div class="announcement{% unless section.settings.scroll %} announcement--static{% endunless %}" {{ section.shopify_attributes }}>
    <div class="announcement__track">
      {%- if section.settings.scroll -%}
        {%- for i in (1..4) -%}
          {%- for block in messages -%}
            <span {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>{{ block.settings.text | escape }}</span>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        <span {{ messages.first.shopify_attributes }}>{{ messages.first.settings.text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "checkbox", "id": "scroll", "label": "Scroll messages", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Weekly 1/1 drops" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}

{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="site-header" data-header>
  <div class="page-width site-header__inner">
    <div>
      <nav class="nav" aria-label="Main">
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="MobileMenu" data-menu-toggle>Menu</button>
    </div>

    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager', widths: '200, 400' }}
      {%- else -%}
        <span class="logo__mark">{{ section.settings.wordmark | escape }}</span>
        {%- if section.settings.script != blank -%}<span class="logo__script">{{ section.settings.script | escape }}</span>{%- endif -%}
      {%- endif -%}
    </a>

    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="hide-mobile">Search</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hide-mobile">Account</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="cart-link" data-cart-open>
        Bag <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Outside <header>: the header slides away on scroll, and a transformed parent would break position: fixed. {%- endcomment -%}
<nav class="mobile-menu" id="MobileMenu" aria-label="Mobile" data-mobile-menu>
  <div class="mobile-menu__links">
    {%- for link in menu.links -%}
      <a href="{{ link.url }}" style="--i: {{ forloop.index0 }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}<span aria-hidden="true">→</span></a>
    {%- endfor -%}
  </div>
  <div class="mobile-menu__foot">
    <a href="{{ routes.search_url }}">Search</a>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">Account</a>
    {%- endif -%}
    {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
    {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
  </div>
</nav>

{%- if section.settings.mobile_bar -%}
  <div class="mobile-bar" data-mobile-bar>
    <a href="{{ routes.all_products_collection_url }}">Shop all</a>
    {%- if section.settings.mobile_bar_label != blank -%}
      <a href="{{ section.settings.mobile_bar_link | default: routes.collections_url }}">{{ section.settings.mobile_bar_label | escape }}</a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="mobile-bar__bag" data-cart-open>Bag <span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use the text wordmark" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "NML" },
    { "type": "text", "id": "script", "label": "Script accent", "default": "club" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Mobile" },
    { "type": "checkbox", "id": "mobile_bar", "label": "Floating shop bar", "info": "Appears at the bottom on phones after scrolling past the hero", "default": true },
    { "type": "text", "id": "mobile_bar_label", "label": "Middle link label", "default": "1/1 crate" },
    { "type": "url", "id": "mobile_bar_link", "label": "Middle link" }
  ]
}
{% endschema %}
